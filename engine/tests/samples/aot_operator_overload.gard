// AOT Operator Overloading Test

class Vector {
    let x: int;
    let y: int;

    constructor(x: int, y: int) {
        this.x = x;
        this.y = y;
    }

    function __add(other: Vector): Vector {
        return new Vector(this.x + other.x, this.y + other.y);
    }

    function __sub(other: Vector): Vector {
        return new Vector(this.x - other.x, this.y - other.y);
    }

    function __mul(other: Vector): Vector {
        return new Vector(this.x * other.x, this.y * other.y);
    }

    function __eq(other: Vector): int {
        if (this.x == other.x) {
            if (this.y == other.y) {
                return 1;
            }
        }
        return 0;
    }

    function display(): void {
        print(this.x);
        print(this.y);
    }
}

function main(): void {
    let v1 = new Vector(1, 2);
    let v2 = new Vector(3, 4);

    // Addition
    let v3 = v1 + v2;
    v3.display();  // 4, 6

    // Subtraction
    let v4 = v2 - v1;
    v4.display();  // 2, 2

    // Multiplication
    let v5 = v1 * v2;
    v5.display();  // 3, 8

    print("operator overload test passed");
}
