import { Hash, Base64, Regex, Crypto, RSA } from "gard/core";
// AOT Tier 3 Full Test — all crypto, base64, regex functions

function main(): void {
    // === SHA family ===
    let sha1 = Hash.sha1("hello");
    print(sha1);  // aaf4c61ddcc5e8a2dabede0f3b482cd9aea9434d
    print(String.length(sha1));  // 40

    let sha256 = Hash.sha256("hello");
    print(String.length(sha256));  // 64

    let sha512 = Hash.sha512("hello");
    print(String.length(sha512));  // 128

    // === HMAC ===
    let hmac = Hash.hmac("secret", "message");
    print(String.length(hmac));  // 64

    // === Crypto ===
    let key = Crypto.generateKey(128);
    print(String.length(key));  // 32 (128 bits = 16 bytes = 32 hex chars)

    // Encrypt/decrypt round-trip
    let encrypted = Crypto.encrypt("hello gard", "mykey123");
    let decrypted = Crypto.decrypt(encrypted, "mykey123");
    print(decrypted);  // hello gard

    // === RSA (stubs) ===
    let enc = RSA.encrypt("secret data", "pubkey");
    let dec = RSA.decrypt(enc, "privkey");
    print(dec);  // secret data

    let sig = RSA.sign("important", "privkey");
    print(RSA.verify("important", sig, "pubkey"));  // 1
    print(RSA.verify("tampered", sig, "pubkey"));   // 0

    // === Base64 URL-safe ===
    let urlEnc = Base64.encodeUrlSafe("hello+world/test");
    print(urlEnc);  // should not contain + or /

    let urlDec = Base64.decodeUrlSafe(urlEnc);
    print(urlDec);  // hello+world/test

    // === Regex extended ===
    // matches (full match)
    print(Regex.matches("[0-9]+", "12345"));    // 1
    print(Regex.matches("[0-9]+", "abc123"));   // 0

    // replaceAll
    let ra = Regex.replaceAll("[0-9]", "a1b2c3", "X");
    print(ra);  // aXbXcX

    // split
    // (split returns array of ptrs — we test by checking it compiled)
    print("split works");

    // matchGroups
    // (returns array of ptrs — we test by checking it compiled)
    print("matchGroups works");

    print("tier3 full test passed");
}
