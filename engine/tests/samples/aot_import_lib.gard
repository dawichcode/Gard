// Library file to be imported

export function add(a: int, b: int): int {
    return a + b;
}

export function multiply(a: int, b: int): int {
    return a * b;
}

export class Calculator {
    let result: int;

    constructor() {
        this.result = 0;
    }

    function add(n: int): void {
        this.result = this.result + n;
    }

    function getResult(): int {
        return this.result;
    }
}
