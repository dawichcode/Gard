function main(): void {
    // Lambda with let inside body
    let factorial = function(n: int): int {
        let result = 1;
        let i = 1;
        while (i <= n) {
            result = result * i;
            i = i + 1;
        }
        return result;
    };
    print(factorial(5));  // 120

    // Simple lambda
    let square = function(x: int): int {
        return x * x;
    };
    print(square(7));  // 49

    // String lambda
    let greet = function(name: string): string {
        let msg = "Hello, " + name;
        return msg;
    };
    print(greet("Gard"));  // Hello, Gard

    // No-param lambda
    let hello = function(): string {
        return "world";
    };
    print(hello());  // world

    print("lambda test passed");
}
