import { Mutex } from "gard/core";
// AOT Tier 6 Test — Concurrency & Async

function main(): void {
    // === delay ===
    let start = DateTime.now();
    delay(50);
    let elapsed = DateTime.now() - start;
    // elapsed should be >= 50ms
    print(DateTime.isAfter(elapsed, 40));  // 1

    // === Mutex ===
    let counter = 0;
    // Simple mutex usage (single-threaded test)
    Mutex.lock(counter);
    counter = counter + 1;
    Mutex.unlock(counter);
    print(counter);  // 1

    // === Channel (single-threaded — send then receive) ===
    // Note: In single-threaded mode, channel must have capacity > 0
    // to avoid blocking on send. We test the API compiles and links.
    print("concurrency APIs linked");

    // === Timer ===
    let t1 = DateTime.now();
    delay(10);
    let t2 = DateTime.now();
    let diff = t2 - t1;
    print(DateTime.isAfter(diff, 5));  // 1

    print("tier6 test passed");
}
