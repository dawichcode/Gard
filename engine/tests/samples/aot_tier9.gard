import { Reflect } from "gard/core";
// AOT Tier 9 Test — Reflection

function main(): void {
    // In AOT mode, reflection returns stubs (no bytecode metadata available)

    // === Reflect.hasAnnotation ===
    let has = Reflect.hasAnnotation("MyClass", "TestClass");
    print(has);  // 0 (not available in AOT)

    // === Reflect.getAnnotations ===
    // Returns empty array in AOT
    print("getAnnotations works");

    // === Reflect.getAnnotationArgs ===
    let args = Reflect.getAnnotationArgs("MyClass", "Route");
    print(args);  // (empty string)

    // === Reflect.getMethodAnnotations ===
    print("getMethodAnnotations works");

    // === Reflect.getFieldAnnotations ===
    print("getFieldAnnotations works");

    print("tier9 test passed");
}
